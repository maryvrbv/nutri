{
  "name": "@nutri/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/seed.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
